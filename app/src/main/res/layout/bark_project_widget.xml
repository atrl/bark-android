<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/project_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bark_project_widget_background" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/project_widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="IC · 次月" android:textColor="#172B2A" android:textSize="14sp" android:textStyle="bold" />
        <ImageView android:id="@+id/project_widget_refresh" android:layout_width="36dp" android:layout_height="32dp"
            android:padding="8dp" android:src="@drawable/bark_ic_refresh" android:contentDescription="刷新行情" />
        <ImageView android:id="@+id/project_widget_configure" android:layout_width="32dp" android:layout_height="32dp"
            android:padding="7dp" android:src="@drawable/bark_ic_more" android:contentDescription="配置项目与合约期限" />
    </LinearLayout>
    <LinearLayout android:id="@+id/project_widget_data" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/project_widget_contract" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#748580" android:textSize="10sp" android:maxLines="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="年化贴水" android:textColor="#748580" android:textSize="10sp" />
                <TextView android:id="@+id/project_widget_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#172B2A" android:textSize="27sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/project_widget_percentile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="5dp"
                android:text="分位 —" android:textColor="#087F70" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/project_widget_chart_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/project_widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY" android:contentDescription="同一合约收盘年化贴水走势" />
            <TextView android:id="@+id/project_widget_chart_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#748580" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/project_widget_asof" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:textColor="#748580" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/project_widget_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#748580" android:textSize="11sp" />
    <TextView android:id="@+id/project_widget_detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="3" android:textColor="#526B62" android:textSize="12sp" />
    <TextView android:id="@+id/project_widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="打开项目 →" android:textColor="#087F70" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
